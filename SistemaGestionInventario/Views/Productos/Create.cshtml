@model SistemaGestionInventario.Models.Producto

@{
    ViewData["Title"] = "Nuevo Producto - StockFlow";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    :root {
        --sf-bg: #14171c;
        --sf-surface: #1b2028;
        --sf-surface-2: #222832;
        --sf-border: #2c3440;
        --sf-text: #e6ebf2;
        --sf-muted: #98a2b3;
        --sf-accent: #5b8def;
        --sf-accent-soft: rgba(91, 141, 239, 0.14);
    }

    body {
        background-color: var(--sf-bg);
        color: var(--sf-text);
    }

    .sf-form-wrapper {
        max-width: 780px;
    }

    .sf-brand {
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--sf-accent);
        font-weight: 600;
    }

    .sf-card {
        background-color: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: 12px;
    }

    .sf-label {
        font-size: 0.84rem;
        font-weight: 500;
        color: #cbd5e1;
        margin-bottom: 0.4rem;
    }

    .sf-input,
    .sf-textarea {
        background-color: var(--sf-surface-2);
        border: 1px solid var(--sf-border);
        color: var(--sf-text);
        border-radius: 8px;
        font-size: 0.92rem;
    }

        .sf-input:focus,
        .sf-textarea:focus {
            background-color: var(--sf-surface-2);
            border-color: var(--sf-accent);
            color: var(--sf-text);
            box-shadow: 0 0 0 0.2rem var(--sf-accent-soft);
        }

    .sf-btn-primary {
        background-color: var(--sf-accent);
        border: 1px solid var(--sf-accent);
        color: #f8fafc;
        font-weight: 500;
        border-radius: 8px;
        padding: 0.52rem 1.2rem;
    }

        .sf-btn-primary:hover {
            background-color: #4a7de0;
            border-color: #4a7de0;
            color: #ffffff;
        }

    .sf-btn-ghost {
        color: var(--sf-muted);
        border: 1px solid var(--sf-border);
        background-color: transparent;
        border-radius: 8px;
        padding: 0.52rem 1.1rem;
    }

        .sf-btn-ghost:hover {
            color: var(--sf-text);
            background-color: var(--sf-surface-2);
        }

    .form-check-input {
        background-color: var(--sf-surface-2);
        border-color: var(--sf-border);
    }

        .form-check-input:checked {
            background-color: var(--sf-accent);
            border-color: var(--sf-accent);
        }
</style>

<div class="container py-4 py-md-5 sf-form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="sf-brand">StockFlow</div>
            <h1 class="h3 fw-semibold mb-1">Registrar Producto</h1>
            <p class="small text-secondary mb-0">Completa los datos base del artículo para incorporarlo al inventario.</p>
        </div>
        <a asp-action="Index" class="btn sf-btn-ghost btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="sf-card p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="Codigo" class="form-label sf-label">Código</label>
                    <input asp-for="Codigo" class="form-control sf-input" placeholder="Ej. PRD-001" />
                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-8">
                    <label asp-for="Nombre" class="form-label sf-label">Nombre del producto</label>
                    <input asp-for="Nombre" class="form-control sf-input" placeholder="Ej. Teclado Mecánico RGB" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="IdCategoria" class="form-label sf-label">ID Categoría</label>
                    @if (ViewBag.Categorias != null)
                    {
                        <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select sf-input">
                            <option value="">-- Seleccionar --</option>
                        </select>
                    }
                    else
                    {
                        <input asp-for="IdCategoria" type="number" min="1" class="form-control sf-input" placeholder="Ej. 1" />
                    }
                    <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="PrecioCompra" class="form-label sf-label">Precio de compra</label>
                    <input asp-for="PrecioCompra" type="number" step="0.01" min="0" class="form-control sf-input" />
                    <span asp-validation-for="PrecioCompra" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="PrecioVenta" class="form-label sf-label">Precio de venta</label>
                    <input asp-for="PrecioVenta" type="number" step="0.01" min="0" class="form-control sf-input" />
                    <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="StockMinimo" class="form-label sf-label">Stock mínimo</label>
                    <input asp-for="StockMinimo" type="number" min="0" class="form-control sf-input" />
                    <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-8 d-flex align-items-end pb-1">
                    <div class="form-check form-switch">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" checked />
                        <label asp-for="Activo" class="form-check-label small text-light">
                            Producto activo disponible para operaciones
                        </label>
                    </div>
                </div>

                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label sf-label">Descripción (opcional)</label>
                    <textarea asp-for="Descripcion" rows="3" class="form-control sf-textarea" placeholder="Características, presentación o notas del producto..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" style="border-color: var(--sf-border);" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn sf-btn-ghost">Cancelar</a>
                <button type="submit" class="btn sf-btn-primary">
                    <i class="bi bi-check2 me-1"></i> Guardar producto
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}