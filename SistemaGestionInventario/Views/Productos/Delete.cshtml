@model SistemaGestionInventario.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto - StockFlow";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    :root {
        --sf-bg: #14171c;
        --sf-surface: #1b2028;
        --sf-surface-2: #222832;
        --sf-border: #2c3440;
        --sf-text: #e6ebf2;
        --sf-muted: #98a2b3;
        --sf-accent: #5b8def;
    }

    body {
        background-color: var(--sf-bg);
        color: var(--sf-text);
    }

    .sf-delete-wrapper {
        max-width: 660px;
    }

    .sf-brand {
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--sf-accent);
        font-weight: 600;
    }

    .sf-card {
        background-color: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: 12px;
    }

    .sf-warning-box {
        background-color: rgba(248, 113, 113, 0.08);
        border: 1px solid rgba(248, 113, 113, 0.28);
        color: #fecaca;
        border-radius: 10px;
        padding: 0.9rem 1rem;
        font-size: 0.9rem;
    }

    .sf-btn-danger {
        background-color: #dc2626;
        border: 1px solid #dc2626;
        color: #ffffff;
        font-weight: 500;
        border-radius: 8px;
        padding: 0.52rem 1.2rem;
    }

        .sf-btn-danger:hover {
            background-color: #b91c1c;
            border-color: #b91c1c;
            color: #ffffff;
        }

    .sf-btn-ghost {
        color: var(--sf-muted);
        border: 1px solid var(--sf-border);
        background-color: transparent;
        border-radius: 8px;
        padding: 0.52rem 1.1rem;
    }

        .sf-btn-ghost:hover {
            color: var(--sf-text);
            background-color: var(--sf-surface-2);
        }
</style>

<div class="container py-4 py-md-5 sf-delete-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="sf-brand">StockFlow</div>
            <h1 class="h3 fw-semibold mb-1">Eliminar Producto</h1>
            <p class="small text-secondary mb-0">Confirma la baja definitiva de este artículo.</p>
        </div>
        <a asp-action="Index" class="btn sf-btn-ghost btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="sf-card p-4">
        <div class="sf-warning-box d-flex align-items-start gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill mt-1 text-danger"></i>
            <div>
                Esta acción eliminará el producto del catálogo. Verifica que no tenga movimientos históricos activos antes de confirmar.
            </div>
        </div>

        <dl class="row mb-0 g-3">
            <dt class="col-sm-4 small text-secondary text-uppercase">Código</dt>
            <dd class="col-sm-8 fw-medium">@Model.Codigo</dd>

            <dt class="col-sm-4 small text-secondary text-uppercase">Nombre</dt>
            <dd class="col-sm-8 fw-medium">@Model.Nombre</dd>

            <dt class="col-sm-4 small text-secondary text-uppercase">Categoría</dt>
            <dd class="col-sm-8">@(Model.Categoria?.Nombre ?? $"Categoría #{Model.IdCategoria}")</dd>

            <dt class="col-sm-4 small text-secondary text-uppercase">Precio Venta</dt>
            <dd class="col-sm-8">@Model.PrecioVenta.ToString("N2")</dd>

            <dt class="col-sm-4 small text-secondary text-uppercase">Stock Mínimo</dt>
            <dd class="col-sm-8">@Model.StockMinimo</dd>
        </dl>

        <hr class="my-4" style="border-color: var(--sf-border);" />

        <form asp-action="Delete" asp-route-id="@Model.IdProducto" method="post" class="d-flex justify-content-end gap-2">
            <input type="hidden" asp-for="IdProducto" />
            <a asp-action="Index" class="btn sf-btn-ghost">Cancelar</a>
            <button type="submit" class="btn sf-btn-danger">
                <i class="bi bi-trash3 me-1"></i> Confirmar eliminación
            </button>
        </form>
    </div>
</div>