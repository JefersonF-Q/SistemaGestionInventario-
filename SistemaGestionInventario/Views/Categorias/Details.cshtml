@model SistemaGestionInventario.Models.Categoria

@{
    ViewData["Title"] = "Detalle de Categoría - StockFlow";
    var cantidadProductos = Model.Productos?.Count ?? 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    :root {
        --sf-bg: #14171c;
        --sf-surface: #1b2028;
        --sf-surface-2: #222832;
        --sf-border: #2c3440;
        --sf-text: #e6ebf2;
        --sf-muted: #98a2b3;
        --sf-accent: #5b8def;
    }

    body {
        background-color: var(--sf-bg);
        color: var(--sf-text);
    }

    .sf-detail-wrapper {
        max-width: 680px;
    }

    .sf-brand {
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--sf-accent);
        font-weight: 600;
    }

    .sf-card {
        background-color: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: 12px;
    }

    .sf-id {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.84rem;
        background-color: var(--sf-surface-2);
        color: #cbd5e1;
        padding: 0.22rem 0.55rem;
        border-radius: 6px;
        border: 1px solid var(--sf-border);
    }

    .sf-field-label {
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--sf-muted);
        margin-bottom: 0.25rem;
    }

    .sf-field-value {
        font-size: 1rem;
        font-weight: 500;
        color: var(--sf-text);
    }

    .sf-btn-primary {
        background-color: var(--sf-accent);
        border: 1px solid var(--sf-accent);
        color: #f8fafc;
        font-weight: 500;
        border-radius: 8px;
        padding: 0.5rem 1.1rem;
    }

        .sf-btn-primary:hover {
            background-color: #4a7de0;
            border-color: #4a7de0;
            color: #ffffff;
        }

    .sf-btn-ghost {
        color: var(--sf-muted);
        border: 1px solid var(--sf-border);
        background-color: transparent;
        border-radius: 8px;
        padding: 0.5rem 1.05rem;
    }

        .sf-btn-ghost:hover {
            color: var(--sf-text);
            background-color: var(--sf-surface-2);
        }
</style>

<div class="container py-4 py-md-5 sf-detail-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="sf-brand">StockFlow</div>
            <h1 class="h3 fw-semibold mb-1">Detalle de Categoría</h1>
            <p class="small text-secondary mb-0">Información registrada para esta clasificación.</p>
        </div>
        <a asp-action="Index" class="btn sf-btn-ghost btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="sf-card p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 pb-3 mb-4" style="border-bottom: 1px solid var(--sf-border);">
            <div>
                <span class="sf-id">#@Model.IdCategoria</span>
                <h2 class="h4 fw-semibold mt-2 mb-0">@Model.Nombre</h2>
            </div>
            <div>
                @if (Model.Activo)
                {
                    <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(16, 185, 129, 0.12); color: #6ee7b7; font-weight: 500;">
                        Activa
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(148, 163, 184, 0.14); color: #cbd5e1; font-weight: 500;">
                        Inactiva
                    </span>
                }
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-sm-6">
                <div class="sf-field-label">Identificador</div>
                <div class="sf-field-value">@Model.IdCategoria</div>
            </div>

            <div class="col-12 col-sm-6">
                <div class="sf-field-label">Productos asociados</div>
                <div class="sf-field-value">@cantidadProductos</div>
            </div>

            <div class="col-12">
                <div class="sf-field-label">Descripción</div>
                <div class="p-3 rounded-3" style="background-color: var(--sf-surface-2); border: 1px solid var(--sf-border); color: #cbd5e1; font-size: 0.92rem;">
                    @(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción registrada." : Model.Descripcion)
                </div>
            </div>
        </div>

        <hr class="my-4" style="border-color: var(--sf-border);" />

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn sf-btn-ghost">Listado</a>
            <a asp-action="Edit" asp-route-id="@Model.IdCategoria" class="btn sf-btn-primary">
                <i class="bi bi-pencil me-1"></i> Editar categoría
            </a>
        </div>
    </div>
</div>