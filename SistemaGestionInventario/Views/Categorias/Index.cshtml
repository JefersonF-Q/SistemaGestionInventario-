@model IEnumerable<SistemaGestionInventario.Models.Categoria>

@{
    ViewData["Title"] = "Categorías - StockFlow";
    var listaCategorias = Model?.ToList() ?? new List<SistemaGestionInventario.Models.Categoria>();
    var totalCategorias = listaCategorias.Count;
    var categoriasActivas = listaCategorias.Count(c => c.Activo);
    var categoriasInactivas = totalCategorias - categoriasActivas;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    :root {
        --sf-bg: #14171c;
        --sf-surface: #1b2028;
        --sf-surface-2: #222832;
        --sf-border: #2c3440;
        --sf-text: #e6ebf2;
        --sf-muted: #98a2b3;
        --sf-accent: #5b8def;
        --sf-accent-soft: rgba(91, 141, 239, 0.14);
        --sf-ok-text: #6ee7b7;
        --sf-ok-bg: rgba(16, 185, 129, 0.12);
        --sf-off-text: #cbd5e1;
        --sf-off-bg: rgba(148, 163, 184, 0.14);
    }

    body {
        background-color: var(--sf-bg);
        color: var(--sf-text);
    }

    .sf-wrapper {
        max-width: 1200px;
    }

    .sf-header {
        border-bottom: 1px solid var(--sf-border);
        padding-bottom: 1.25rem;
    }

    .sf-brand {
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--sf-accent);
        font-weight: 600;
    }

    .sf-title {
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--sf-text);
        margin: 0;
    }

    .sf-subtitle {
        color: var(--sf-muted);
        font-size: 0.92rem;
        margin: 0.25rem 0 0;
    }

    .sf-card {
        background-color: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: 12px;
    }

    .sf-stat-label {
        font-size: 0.78rem;
        color: var(--sf-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .sf-stat-value {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--sf-text);
        margin-top: 0.15rem;
    }

    .sf-toolbar .form-control,
    .sf-toolbar .form-select {
        background-color: var(--sf-surface-2);
        border: 1px solid var(--sf-border);
        color: var(--sf-text);
        border-radius: 8px;
        font-size: 0.9rem;
    }

        .sf-toolbar .form-control::placeholder {
            color: var(--sf-muted);
        }

        .sf-toolbar .form-control:focus,
        .sf-toolbar .form-select:focus {
            background-color: var(--sf-surface-2);
            border-color: var(--sf-accent);
            color: var(--sf-text);
            box-shadow: 0 0 0 0.2rem var(--sf-accent-soft);
        }

    .sf-btn-primary {
        background-color: var(--sf-accent);
        border: 1px solid var(--sf-accent);
        color: #f8fafc;
        font-weight: 500;
        border-radius: 8px;
        padding: 0.5rem 1rem;
    }

        .sf-btn-primary:hover {
            background-color: #4a7de0;
            border-color: #4a7de0;
            color: #ffffff;
        }

    .sf-table {
        --bs-table-bg: transparent;
        --bs-table-color: var(--sf-text);
        --bs-table-border-color: var(--sf-border);
        --bs-table-hover-bg: rgba(255, 255, 255, 0.025);
        --bs-table-hover-color: var(--sf-text);
        margin-bottom: 0;
    }

        .sf-table thead th {
            background-color: var(--sf-surface-2);
            color: var(--sf-muted);
            font-size: 0.76rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-bottom: 1px solid var(--sf-border);
            padding: 0.85rem 1rem;
            white-space: nowrap;
        }

        .sf-table tbody td {
            padding: 0.9rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid var(--sf-border);
            font-size: 0.9rem;
        }

    .sf-id {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.82rem;
        background-color: var(--sf-surface-2);
        color: #cbd5e1;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        border: 1px solid var(--sf-border);
    }

    .sf-badge-active {
        background-color: var(--sf-ok-bg);
        color: var(--sf-ok-text);
        font-weight: 500;
        font-size: 0.76rem;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
    }

    .sf-badge-inactive {
        background-color: var(--sf-off-bg);
        color: var(--sf-off-text);
        font-weight: 500;
        font-size: 0.76rem;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
    }

    .sf-action-btn {
        color: var(--sf-muted);
        border: 1px solid var(--sf-border);
        background-color: transparent;
        border-radius: 7px;
        padding: 0.3rem 0.55rem;
        font-size: 0.85rem;
        transition: all 0.15s ease;
    }

        .sf-action-btn:hover {
            color: var(--sf-text);
            background-color: var(--sf-surface-2);
            border-color: #3b4656;
        }

        .sf-action-btn.delete:hover {
            color: #fca5a5;
            border-color: rgba(248, 113, 113, 0.45);
            background-color: rgba(248, 113, 113, 0.1);
        }

    .sf-empty {
        padding: 3.5rem 1.5rem;
        text-align: center;
        color: var(--sf-muted);
    }
</style>

<div class="container py-4 py-md-5 sf-wrapper">
    <!-- Encabezado -->
    <div class="sf-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="sf-brand">StockFlow</div>
            <h1 class="h3 sf-title">Categorías de Productos</h1>
            <p class="sf-subtitle">Clasificación y estado operativo de las líneas de inventario.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn sf-btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Nueva categoría
            </a>
        </div>
    </div>

    <!-- Métricas mínimas -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <div class="sf-card p-3">
                <div class="sf-stat-label">Total categorías</div>
                <div class="sf-stat-value">@totalCategorias</div>
            </div>
        </div>
        <div class="col-12 col-sm-4">
            <div class="sf-card p-3">
                <div class="sf-stat-label">Activas</div>
                <div class="sf-stat-value">@categoriasActivas</div>
            </div>
        </div>
        <div class="col-12 col-sm-4">
            <div class="sf-card p-3">
                <div class="sf-stat-label">Inactivas</div>
                <div class="sf-stat-value">@categoriasInactivas</div>
            </div>
        </div>
    </div>

    <!-- Buscador y filtro -->
    <div class="sf-card p-3 mb-4 sf-toolbar">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-0 text-secondary ps-2">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           id="buscarCategoria"
                           class="form-control"
                           placeholder="Buscar por nombre o descripción..." />
                </div>
            </div>
            <div class="col-12 col-md-5">
                <select id="filtroEstado" class="form-select">
                    <option value="todos">Todos los estados</option>
                    <option value="activo">Solo activas</option>
                    <option value="inactivo">Solo inactivas</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="sf-card overflow-hidden">
        @if (!listaCategorias.Any())
        {
            <div class="sf-empty">
                <i class="bi bi-tags fs-2 d-block mb-2"></i>
                <p class="mb-3">Aún no hay categorías registradas en StockFlow.</p>
                <a asp-action="Create" class="btn sf-btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Registrar primera categoría
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table sf-table table-hover" id="tablaCategorias">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in listaCategorias)
                        {
                            var estadoTexto = item.Activo ? "activo" : "inactivo";
                            var textoBusqueda = $"{item.Nombre} {item.Descripcion}".ToLowerInvariant();

                            <tr data-estado="@estadoTexto" data-busqueda="@textoBusqueda">
                                <td>
                                    <span class="sf-id">#@item.IdCategoria</span>
                                </td>
                                <td class="fw-medium">
                                    @item.Nombre
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                    {
                                        <span class="text-secondary">@item.Descripcion</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary fst-italic">Sin descripción</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="sf-badge-active">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="sf-badge-inactive">Inactiva</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details"
                                           asp-route-id="@item.IdCategoria"
                                           class="btn sf-action-btn"
                                           title="Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.IdCategoria"
                                           class="btn sf-action-btn"
                                           title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.IdCategoria"
                                           class="btn sf-action-btn delete"
                                           title="Eliminar">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<script>
    (function () {
        const inputBuscar = document.getElementById("buscarCategoria");
        const selectEstado = document.getElementById("filtroEstado");
        const filas = document.querySelectorAll("#tablaCategorias tbody tr");

        function filtrarTabla() {
            const termino = (inputBuscar?.value || "").trim().toLowerCase();
            const estado = selectEstado?.value || "todos";

            filas.forEach((fila) => {
                const coincideTexto = !termino || (fila.dataset.busqueda || "").includes(termino);
                const coincideEstado = estado === "todos" || fila.dataset.estado === estado;
                fila.style.display = coincideTexto && coincideEstado ? "" : "none";
            });
        }

        inputBuscar?.addEventListener("input", filtrarTabla);
        selectEstado?.addEventListener("change", filtrarTabla);
    })();
</script>